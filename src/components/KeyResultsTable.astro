---
import DataState from "./DataState.astro";
import { cellNumber, cellText, formatCell, formatValue } from "../data/rows";
import { displayForReport } from "../data/standard";
import { phiusCompliance, phiusComplianceLabel } from "../data/phius-compliance";

import type { TemplateReportData } from "../data/report";

interface Props {
  data: TemplateReportData;
  caption?: string;
}

type CsvSource = "variants" | "certification";

interface SummaryMetric {
  label: string;
  units: string;
  source: CsvSource;
  fieldId?: string;
  metric?: string;
  role?: string;
  /** Multiplies a numeric variants-sheet value before display (unit conversion). */
  factor?: number;
}

const { data, caption = "Key Results By Variant" } = Astro.props;
const display = displayForReport(data);
const allMetrics: SummaryMetric[] = [
  {
    label: "Certification Compliant?",
    units: "",
    source: "variants",
    fieldId: "certification_compliant.certification_compliant_2",
  },
  {
    label: display.primaryEnergyLabel,
    units: "kWh/yr",
    source: "variants",
    fieldId: "report_inputs.total_primary_energy",
  },
  {
    label: "Total Site Energy",
    units: "kWh/yr",
    source: "variants",
    fieldId: "report_inputs.total_site_energy",
  },
  {
    label: "Heat Demand",
    units: "kWh/yr",
    source: "certification",
    metric: "heat_demand",
    role: "result",
  },
  {
    label: "Heat Demand",
    units: display.specificDemandUnits,
    source: "variants",
    fieldId: "certification_results.heat_demand",
    factor: display.specificDemandFactor,
  },
  {
    label: "Cooling Demand",
    units: "kWh/yr",
    source: "certification",
    metric: "sensible_cooling_demand",
    role: "result",
  },
  {
    label: "Total Cooling Demand",
    units: display.specificDemandUnits,
    source: "variants",
    fieldId: "certification_results.total_cooling_demand",
    factor: display.specificDemandFactor,
  },
  {
    label: "Peak Heat Load",
    units: "Btuh",
    source: "variants",
    fieldId: "peak_loads.peak_heat_load",
  },
  {
    label: "Peak Sensible Cooling Load",
    units: "Btuh",
    source: "variants",
    fieldId: "peak_loads.peak_sensible_cooling_load",
  },
  {
    label: "Peak Latent Cooling Load",
    units: "Btuh",
    source: "variants",
    fieldId: "peak_loads.peak_latent_cooling_load",
  },
];
const metrics = allMetrics;
const COMPLIANCE_FIELD = "certification_compliant.certification_compliant_2";
const cfm50LimitText = data.project?.narrative?.certification?.phius_cfm50_limit;
const cfm50Limit = cfm50LimitText ? Number(cfm50LimitText) : null;

function valueFor(metric: SummaryMetric, variantId: string): string {
  // PHPP's compliance cell checks PHI criteria, so Phius reports evaluate the Phius criteria instead.
  if (display.standard === "phius" && metric.fieldId === COMPLIANCE_FIELD) {
    return phiusComplianceLabel(
      phiusCompliance(data, variantId, cfm50Limit !== null && Number.isFinite(cfm50Limit) ? cfm50Limit : null),
    );
  }
  if (metric.source === "variants") {
    const row = data.variants.find(
      (candidate) => cellText(candidate, "field_id") === metric.fieldId && cellText(candidate, "variant_id") === variantId,
    );
    if (!row) return "—";
    if (metric.factor !== undefined && metric.factor !== 1) {
      const value = cellNumber(row, "value");
      return value === null ? formatCell(row.value) : formatValue(value * metric.factor);
    }
    return formatCell(row.value);
  }

  const row = data.certification.find(
    (candidate) =>
      cellText(candidate, "metric") === metric.metric &&
      cellText(candidate, "role") === metric.role &&
      cellText(candidate, "variant_id") === variantId,
  );
  return formatValue(cellNumber(row ?? {}, "value"));
}

const rows = metrics.map((metric) => ({
  ...metric,
  values: new Map(data.variantOrder.map((variant) => [variant.id, valueFor(metric, variant.id)])),
}));
const recommendedName = data.variantOrder.find((variant) => variant.recommended)?.name ?? "the recommended variant";
const hasRows = rows.some((row) => [...row.values.values()].some((value) => value !== "—"));
---

{
  data.manifest.status === "pending" || !hasRows ? (
    <DataState state="pending" title="Energy table pending" message="No energy summary rows are available yet." />
  ) : (
    <div class="btwr-table-wrap btwr-table-wrap--long">
      <table class="btwr-table btwr-energy-summary-table" data-table="energy-summary">
        <caption>
          <strong class="btwr-table__title">{caption}</strong>
          <span class="btwr-table__subtitle">
            This table lists some of the key output results for each of the variants tested as part of this investigation.
            Values from the recommended variant, {recommendedName}, are highlighted.
          </span>
        </caption>
        <thead>
          <tr>
            <th>Metric</th>
            {data.variantOrder.map((variant) => (
              <th class={variant.recommended ? "btwr-col-recommended" : undefined}>
                {variant.recommended && <span class="btwr-recommended-tag">Recommended</span>}
                {variant.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th>
                <span>{row.label}</span>
                {row.units && <small class="btwr-table__metric-unit">{row.units}</small>}
              </th>
              {data.variantOrder.map((variant) => (
                <td class={`btwr-cell-number ${variant.recommended ? "btwr-col-recommended" : ""}`}>
                  {row.values.get(variant.id)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
