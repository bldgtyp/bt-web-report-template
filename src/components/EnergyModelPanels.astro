---
import CertificationChart from "../charts/CertificationChart.astro";
import CertificationTable from "./tables/CertificationTable.astro";
import ClimateMonthlyChart from "../charts/ClimateMonthlyChart.astro";
import DemandBreakdownChart from "../charts/DemandBreakdownChart.astro";
import SiteEnergyChart from "../charts/SiteEnergyChart.astro";
import SourceEnergyChart from "../charts/SourceEnergyChart.astro";

import KeyResultsTable from "./KeyResultsTable.astro";
import { loadTemplateReportData } from "../data/report";

const report = await loadTemplateReportData();
---

<div class="btwr-component-stack">
  <SiteEnergyChart data={report} title="Annual site energy" />
  <SourceEnergyChart data={report} title="Source energy comparison" />
  <DemandBreakdownChart data={report} demandType="heating" title="Heating demand breakdown" />
  <ClimateMonthlyChart data={report} title="Monthly climate profile" />
  <CertificationChart data={report} title="Passive House thresholds" />
  <KeyResultsTable data={report} caption="Key results by variant" />
  <CertificationTable data={report} caption="Certification result and limit rows" />
</div>
