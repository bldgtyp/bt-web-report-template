---
// Extras adapter for the `envelope-heat-loss` section: the registry hands
// every component `report`, while the chart's own API takes `data`.
import EnvelopeHeatLossChart from "../../charts/EnvelopeHeatLossChart.astro";
import type { TemplateReportData } from "../../data/report";

interface Props {
  report: TemplateReportData;
}

const { report } = Astro.props;
---

<EnvelopeHeatLossChart data={report} />
