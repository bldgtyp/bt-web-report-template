---
import type { ReportPage } from "../data/pages";

interface Props {
  pageOrder: readonly ReportPage[];
}

const { pageOrder } = Astro.props;
const links = pageOrder.filter((item) => item.href !== "/");
---

<nav class="btwr-page-links" aria-label="Report pages">
  {links.map((item) => (
    <a href={item.href}>
      <span class="btwr-page-links__title">{item.label}</span>
      <small>Open section</small>
      <span class="btwr-page-links__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M5 12h12m-5-5 5 5-5 5" />
        </svg>
      </span>
    </a>
  ))}
</nav>
