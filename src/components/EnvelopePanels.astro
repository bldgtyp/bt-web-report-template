---
import BuildingMetricsTable from "./BuildingMetricsTable.astro";
import VariantInputsTable from "./VariantInputsTable.astro";

import { loadTemplateReportData } from "../data/report";

const report = await loadTemplateReportData();
---

<div class="btwr-component-stack">
  <BuildingMetricsTable data={report} caption="Model geometry and building metrics" />
  <VariantInputsTable data={report} sections={["geometry", "envelope", "windows"]} caption="Envelope and geometry assumptions" />
</div>
