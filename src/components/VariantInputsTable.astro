---
import { DataState, cellText, formatCell, labelize } from "@bldgtyp/web-report-kit";

import type { TemplateReportData } from "../data/report";

interface Props {
  data: TemplateReportData;
  sections?: string[];
  caption?: string;
  captionSubtitle?: string;
  limit?: number;
  showSource?: boolean;
}

const {
  data,
  sections = ["geometry", "certification_limits"],
  caption = "Variant inputs by variant",
  captionSubtitle = "This table lists selected model inputs for each variant tested as part of this investigation. Values from the recommended variant are highlighted.",
  limit = 28,
  showSource = true,
} = Astro.props;
const sectionSet = new Set(sections);
const rowKeys = new Map<string, { section: string; fieldId: string; label: string; units: string; excelRow: string }>();
for (const row of data.variants) {
  const section = cellText(row, "section");
  if (!sectionSet.has(section)) {
    continue;
  }
  const fieldId = cellText(row, "field_id");
  if (!rowKeys.has(fieldId)) {
    rowKeys.set(fieldId, {
      section,
      fieldId,
      label: cellText(row, "phpp_label") || labelize(fieldId),
      units: cellText(row, "units"),
      excelRow: cellText(row, "excel_row"),
    });
  }
}
const rows = [...rowKeys.values()].slice(0, limit).map((key) => {
  const values = new Map(
    data.variantOrder.map((variant) => {
      const row = data.variants.find(
        (candidate) => cellText(candidate, "field_id") === key.fieldId && cellText(candidate, "variant_id") === variant.id,
      );
      return [variant.id, row ? formatCell(row.value) : "—"];
    }),
  );
  return { ...key, values };
});
---

{
  data.manifest.status === "pending" || rows.length === 0 ? (
    <DataState state="pending" title="Variant inputs pending" message="No matching variant input rows are available yet." />
  ) : (
    <div class="btwr-table-wrap">
      <table class="btwr-table" data-table="variant-inputs">
        <caption>
          <strong class="btwr-table__title">{caption}</strong>
          <span class="btwr-table__subtitle">{captionSubtitle}</span>
        </caption>
        <thead>
          <tr>
            <th>PHPP row</th>
            {data.variantOrder.map((variant) => (
              <th class={variant.recommended ? "btwr-col-recommended" : undefined}>
                {variant.recommended && <span class="btwr-recommended-tag">Recommended</span>}
                {variant.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th>
                {row.label}
                {row.units && <small class="btwr-table__metric-unit">{row.units}</small>}
                {showSource && (
                  <span class="btwr-cell-muted">
                    {labelize(row.section)}
                    {" · "}
                    {row.fieldId}
                    {row.excelRow ? ` · row ${row.excelRow}` : ""}
                  </span>
                )}
              </th>
              {data.variantOrder.map((variant) => (
                <td class={`btwr-cell-number ${variant.recommended ? "btwr-col-recommended" : ""}`}>
                  {row.values.get(variant.id)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
