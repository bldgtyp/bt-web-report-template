---
interface AssemblyFrontmatter {
  title: string;
  order?: number;
  image?: string;
  pdf?: string;
  notes?: string[];
}

interface AssemblyModule {
  frontmatter: AssemblyFrontmatter;
  url?: string;
}

const assemblyModules = import.meta.glob<AssemblyModule>("../../content/envelope/assemblies/*.mdx", { eager: true });
const archiveName = "recommended-assemblies.zip";
const assemblies = Object.entries(assemblyModules)
  .map(([path, module]) => ({
    ...module.frontmatter,
    slug: path.split("/").pop()?.replace(/\.mdx$/, "") ?? module.frontmatter.title,
  }))
  .sort((left, right) => (left.order ?? 999) - (right.order ?? 999) || left.title.localeCompare(right.title));

const archiveFiles = assemblies
  .map((assembly) => {
    const url = assembly.image ?? assembly.pdf;
    if (!url) {
      return null;
    }
    return {
      url,
      filename: filenameFromUrl(url),
    };
  })
  .filter((file): file is { url: string; filename: string } => file !== null);

function filenameFromUrl(value: string): string {
  const path = value.split("?")[0]?.split("#")[0] ?? value;
  return path.split("/").filter(Boolean).pop() ?? "assembly";
}
---

{
  assemblies.length > 0 ? (
    <>
      {archiveFiles.length > 0 ? (
        <button
          class="btwr-assembly-download"
          type="button"
          data-assembly-archive-files={JSON.stringify(archiveFiles)}
          data-assembly-archive-name={archiveName}
          data-label-default="Download Assemblies"
          data-label-busy="Preparing..."
        >
          Download Assemblies
        </button>
      ) : null}
      <div class="btwr-assembly-list" aria-label="Recommended assembly types">
        {assemblies.map((assembly) => (
          <article class="btwr-assembly-card">
            <h3>{assembly.title}</h3>
            <div class="btwr-assembly-card__body">
              {assembly.image ? (
                <a
                  class="btwr-assembly-card__image"
                  href={assembly.pdf ?? assembly.image}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${assembly.title} assembly detail`}
                >
                  <img src={assembly.image} alt={`${assembly.title} assembly diagram`} loading="lazy" />
                </a>
              ) : null}
              {assembly.notes && assembly.notes.length > 0 ? (
                <ul>
                  {assembly.notes.map((note) => (
                    <li>{note}</li>
                  ))}
                </ul>
              ) : null}
            </div>
          </article>
        ))}
      </div>
    </>
  ) : (
    <div class="btwr-placeholder-panel">
      <span>ADD ASSEMBLY FILES IN CONTENT/ENVELOPE/ASSEMBLIES</span>
    </div>
  )
}

<script>
  import { setupAssemblyArchiveDownloads } from "../scripts/assembly-archive";

  setupAssemblyArchiveDownloads();
</script>
