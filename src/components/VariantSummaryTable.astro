---
import VariantInputsTable from "./tables/VariantInputsTable.astro";

import KeyResultsTable from "./KeyResultsTable.astro";
import { loadTemplateReportData } from "../data/report";

const report = await loadTemplateReportData();
---

<div class="btwr-component-stack">
  <KeyResultsTable data={report} caption="Energy summary by variant" />
  <VariantInputsTable data={report} caption="Variant inputs and assumptions" />
</div>
