---
interface Props {
  href?: string;
}

const { href = "/report.pdf" } = Astro.props;
---

<div class="btwr-pdf-download">
  <a class="btwr-pdf-download__primary" href={href} download>
    <svg class="btwr-pdf-download__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 3v12m0 0-4-4m4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span>Download PDF</span>
  </a>
</div>
