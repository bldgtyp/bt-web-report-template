---
interface Props {
  href?: string;
}

const { href = "/report.pdf" } = Astro.props;

// The PDF is a deploy-time build artifact: scripts/build-pdf.mjs runs after
// `astro build` in CI and ships dist/report.pdf with the Cloudflare deploy. It
// does NOT exist under `astro dev` (the Manager's "Dev preview"), so a plain
// link there 404s. Render a disabled pending state in dev instead.
// See context/plans/2026-05-22/pdf-export.html#download-button.
const pdfAvailable = !import.meta.env.DEV;
---

<div class="btwr-pdf-download">
  {
    pdfAvailable ? (
      <a class="btwr-pdf-download__primary" href={href} download>
        <svg class="btwr-pdf-download__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3v12m0 0-4-4m4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>Download the Report As PDF</span>
      </a>
    ) : (
      <span
        class="btwr-pdf-download__primary is-pending"
        aria-disabled="true"
        title="The PDF is generated when the report is published/deployed."
      >
        <svg class="btwr-pdf-download__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M12 3v12m0 0-4-4m4 4 4-4M5 19h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>PDF builds on publish</span>
      </span>
    )
  }
</div>
