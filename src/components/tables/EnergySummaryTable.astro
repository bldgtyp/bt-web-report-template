---
import DataState from "../DataState.astro";
import type { ReportData } from "../../data/report-loader";
import { cellNumber, cellText, formatValue, labelize } from "../../data/rows";

interface Props {
  data: ReportData;
  metricGroups?: string[];
  caption?: string;
  captionSubtitle?: string;
}

const {
  data,
  metricGroups = ["site_energy", "primary_energy", "per", "co2e"],
  caption = "Energy summary by variant",
  captionSubtitle = "This table lists key output results for each variant tested as part of this investigation. Values from the recommended variant are highlighted.",
} = Astro.props;
const rows = metricGroups.map((metricGroup) => {
  const metricRows = data.energy.filter((row) => cellText(row, "metric_group") === metricGroup);
  const units = cellText(metricRows[0] ?? {}, "units");
  const values = new Map(
    data.variantOrder.map((variant) => [
      variant.id,
      metricRows
        .filter((row) => cellText(row, "variant_id") === variant.id)
        .reduce((sum, row) => sum + (cellNumber(row, "value") ?? 0), 0),
    ]),
  );
  return { metricGroup, units, values };
});
const hasRows = rows.some((row) => [...row.values.values()].some((value) => value !== 0));
---

{
  data.manifest.status === "pending" || !hasRows ? (
    <DataState state="pending" title="Energy table pending" message="No energy rows are available yet." />
  ) : (
    <div class="btwr-table-wrap">
      <table class="btwr-table" data-table="energy-summary">
        <caption>
          <strong class="btwr-table__title">{caption}</strong>
          <span class="btwr-table__subtitle">{captionSubtitle}</span>
        </caption>
        <thead>
          <tr>
            <th>Metric</th>
            {data.variantOrder.map((variant) => (
              <th class={variant.recommended ? "btwr-col-recommended" : undefined}>
                {variant.recommended && <span class="btwr-recommended-tag">Recommended</span>}
                {variant.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr>
              <th>
                {labelize(row.metricGroup)}
                {row.units && <small class="btwr-table__metric-unit">{row.units}</small>}
              </th>
              {data.variantOrder.map((variant) => (
                <td class={`btwr-cell-number ${variant.recommended ? "btwr-col-recommended" : ""}`}>
                  {formatValue(row.values.get(variant.id) ?? null)}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
