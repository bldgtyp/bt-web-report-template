---
// <VarLink hrefKey="..." /> — MDX shortcode for links whose href comes from project.yaml.

import type { ProjectConfig } from "../data/project";
import { resolveVar } from "../data/resolve-var";
import { isFullUrl, newTabRel } from "../markdown/remark-full-url-links-new-tab.mjs";

interface Props {
  hrefKey: string;
  target?: string;
  rel?: string;
}

const { hrefKey, target, rel } = Astro.props;
const project = Astro.locals.project as ProjectConfig | undefined;

if (!project) {
  throw new Error(
    `<VarLink hrefKey="${hrefKey}" />: Astro.locals.project is not set. Ensure src/middleware/index.ts is registered.`,
  );
}

const result = resolveVar(project, hrefKey);

if (!result.found) {
  console.warn(
    `[VarLink] missing key '${hrefKey}' (${result.reason}). Rendering '#' placeholder href. Add the field to project.yaml or fix the reference.`,
  );
}

const href = result.found ? result.value : "#";
const opensNewTab = isFullUrl(href);
const linkTarget = opensNewTab ? "_blank" : target;
const linkRel = opensNewTab ? newTabRel(rel) : rel;
---

<a href={href} target={linkTarget} rel={linkRel}>
  <slot />
</a>
