---
// <Var k="..." /> — MDX shortcode that resolves a dot-path into project.yaml.
//
// Reads the active project from Astro.locals (set by src/middleware/index.ts).
// On missing keys: emits a build warning and renders a visible
// [MISSING: ...] placeholder in BOTH dev and prod. We do NOT throw — the
// platform must tolerate template content that references new
// project.yaml fields older per-project repos haven't adopted yet.
// The placeholder makes the gap obvious in the rendered page, and the
// warning is captured in CI logs so it can be triaged without blocking
// the deploy.
//
// Wire-up: include `Var` in the components map passed to MDX content, e.g.
//   <Content components={{ Var }} />
// ReportSection does this for every section by default.

import type { ProjectConfig } from "../data/project";
import { resolveVar } from "../data/resolve-var";

interface Props {
  k: string;
}

const { k } = Astro.props;
const project = Astro.locals.project as ProjectConfig | undefined;

if (!project) {
  throw new Error(
    `<Var k="${k}" />: Astro.locals.project is not set. Ensure src/middleware/index.ts is registered.`,
  );
}

const result = resolveVar(project, k);

if (!result.found) {
  console.warn(
    `[Var] missing key '${k}' (${result.reason}). Rendering placeholder. Add the field to project.yaml or fix the reference.`,
  );
}
---
{result.found ? result.value : `[MISSING: ${k}]`}
