---
import SectionHeading from "./SectionHeading.astro";
import Var from "./Var.astro";
import VarLink from "./VarLink.astro";

interface Props {
  id: string;
  kicker: string;
  title: string;
  Content?: any;
  callout_label?: string;
  callout_body?: string;
  show_heading?: boolean;
}

const { id, kicker, title, Content, callout_label, callout_body, show_heading = true } = Astro.props;

// Shortcodes available to every MDX section. Add new shortcodes here, not
// per-page, so authors get a consistent surface across the report.
const mdxComponents = { Var, VarLink };
---

<section class="btwr-section" aria-labelledby={id}>
  {show_heading && <SectionHeading id={id} kicker={kicker} title={title} />}
  {!show_heading && <h2 id={id} class="btwr-section-heading__standalone">{title}</h2>}
  <slot name="before-content" />
  {Content && (
    <div class="btwr-prose">
      <Content components={mdxComponents} />
    </div>
  )}
  {
    callout_label && callout_body ? (
      <div class="btwr-callout">
        <strong>{callout_label}</strong>
        <span>{callout_body}</span>
      </div>
    ) : null
  }
  <slot />
</section>
