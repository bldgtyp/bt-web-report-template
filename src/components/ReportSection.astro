---
import { SectionHeading } from "@bldgtyp/web-report-kit";

interface Props {
  id: string;
  kicker: string;
  title: string;
  dek: string;
  Content: any;
  callout_label?: string;
  callout_body?: string;
  show_heading?: boolean;
}

const { id, kicker, title, dek, Content, callout_label, callout_body, show_heading = true } = Astro.props;
---

<section class="btwr-section" aria-labelledby={id}>
  {show_heading && <SectionHeading id={id} kicker={kicker} title={title} />}
  <h2 class="btwr-editorial-heading">{dek}</h2>
  <div class="btwr-prose">
    <Content />
  </div>
  {
    callout_label && callout_body ? (
      <div class="btwr-callout">
        <strong>{callout_label}</strong>
        <span>{callout_body}</span>
      </div>
    ) : null
  }
  <slot />
</section>
