---
import MetricCard from "../components/MetricCard.astro";
import {
  loadResilienceSeries,
  WINTER_SET_LIMIT_K_H,
  WINTER_SET_THRESHOLD_C,
  winterSetMetrics,
} from "../data/resilience";
import { variantColor } from "../data/rows";
import { timeSeriesChart, type TimeSeriesDatum } from "./plot";

const series = await loadResilienceSeries("winter");
const metrics = winterSetMetrics(series);
const colors = series.zones.map((_, index) => variantColor(index));
const chartData: TimeSeriesDatum[] = series.zones.flatMap((zone) =>
  zone.values.map((value, index) => ({ timestamp: series.timestamps[index], value, series: zone.label })),
);
const svg = await timeSeriesChart(chartData, {
  yLabel: "Standard Effective Temperature (°C)",
  colorDomain: series.zones.map((zone) => zone.label),
  colorRange: colors,
  outageStart: series.timestamps[series.outageStartIndex],
  outageEnd: new Date(series.timestamps[series.outageEndIndex - 1].getTime() + 3_600_000),
  threshold: WINTER_SET_THRESHOLD_C,
  thresholdLabel: "54°F / 12.22°C degree-hour datum",
});
---

<div class="btwr-component-stack" data-resilience-chart="winter-set">
  <figure class="btwr-chart-frame">
    <div class="btwr-chart-frame__header">
      <h3>Winter outage Standard Effective Temperature</h3>
      <p class="btwr-chart-frame__subtitle">
        Full simulation series; the shaded interval is the declared 168-hour outage. REVIVE v24.1.1 limits the SET
        deficit below 54°F (12.22°C) to 216°F·h (120 K·h) per thermal block.
      </p>
    </div>
    <ul class="btwr-chart-legend" aria-label="Winter SET zones">
      {
        series.zones.map((zone, index) => (
          <li><span style={`--btwr-legend-color: ${colors[index]}`}></span>{zone.label}</li>
        ))
      }
    </ul>
    <div class="btwr-chart-frame__plot" set:html={svg} />
    <p class="btwr-chart-frame__meta">
      Source: {series.config.source}. Generated by {series.config.generator}. This chart evaluates the SET degree-hour
      criterion only; the separate zero-hours-below-36°F air-temperature criterion is not inferred from SET.
    </p>
  </figure>
  <div class="btwr-metric-grid">
    {
      series.zones.map((zone) => {
        const metric = metrics[zone.id];
        return (
          <MetricCard
            label={zone.label}
            value={`${metric.degreeHoursKH.toFixed(1)} K·h`}
            note={`${metric.passesSetCriterion ? "Pass" : "Does not pass"} · limit ${WINTER_SET_LIMIT_K_H} K·h`}
          />
        );
      })
    }
  </div>
</div>
