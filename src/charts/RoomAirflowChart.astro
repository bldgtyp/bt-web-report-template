---
import DataState from "../components/DataState.astro";
import type { ReportData } from "../data/report-loader";
import { cellNumber, cellText } from "../data/rows";
import { barChart, type PlotSeriesDatum } from "./plot";

interface Props {
  data: ReportData;
  subtitle?: string;
  title?: string;
}

const { data, subtitle: subtitleProp, title = "Room airflow high-rate balance" } = Astro.props;
const roomRows = data.roomAirflows
  .filter((row) => cellText(row, "row_type") === "room")
  .map((row) => ({
    row,
    supply: cellNumber(row, "v_sup_high_cfm") ?? 0,
    extract: cellNumber(row, "v_eta_high_cfm") ?? 0,
  }))
  .filter((row) => row.supply > 0 || row.extract > 0)
  .sort((a, b) => b.supply + b.extract - (a.supply + a.extract))
  .slice(0, 14);
const chartRows: PlotSeriesDatum[] = roomRows.flatMap(({ row, supply, extract }) => {
  const room = cellText(row, "room_name").replace(/^\d+[A-Z]*-?/, "");
  return [
    { label: room, series: "Supply", units: "cfm", value: supply },
    { label: room, series: "Extract", units: "cfm", value: -extract },
  ].filter((item) => item.value !== 0);
});
const legendItems = [
  { label: "Supply", color: "var(--btwr-chart-cooling)" },
  { label: "Extract", color: "var(--btwr-chart-pumps)" },
];
const subtitle = subtitleProp ?? "High-rate supply and extract airflow by PHPP room, in cfm.";
const svg =
  chartRows.length > 0
    ? await barChart(chartRows, {
        yLabel: "Airflow (cfm)",
        colorDomain: legendItems.map((item) => item.label),
        colorRange: legendItems.map((item) => item.color),
        units: "cfm",
      })
    : "";
---

{
  data.manifest.status === "pending" || chartRows.length === 0 ? (
    <DataState state="pending" title="Room airflow chart pending" message="No supply or extract room airflow rows are available yet." />
  ) : (
    <figure class="btwr-chart-frame" data-chart="room-airflow">
      <div class="btwr-chart-frame__header">
        <h3>{title}</h3>
        <p class="btwr-chart-frame__subtitle">{subtitle}</p>
      </div>
      <ul class="btwr-chart-legend" aria-label="Room airflow series">
        {legendItems.map((item) => <li><span style={`--btwr-legend-color: ${item.color}`}></span>{item.label}</li>)}
      </ul>
      <div class="btwr-chart-frame__plot" set:html={svg} />
    </figure>
  )
}
