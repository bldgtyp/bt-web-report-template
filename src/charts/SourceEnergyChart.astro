---
import DataState from "../components/DataState.astro";
import type { ReportData } from "../data/report-loader";
import { cellNumber, cellText, labelize } from "../data/rows";
import { barChart, variantPalette, type PlotSeriesDatum } from "./plot";

interface Props {
  data: ReportData;
  metricGroup?: "primary_energy" | "per" | "co2e" | "phius_net_source_energy";
  subtitle?: string;
  title?: string;
}

const { data, metricGroup = "primary_energy", subtitle: subtitleProp, title = "Source energy comparison" } = Astro.props;
const rows = data.energy.filter((row) => cellText(row, "metric_group") === metricGroup);
const units = cellText(rows[0] ?? {}, "units") || "";
const palette = variantPalette(data.variantOrder);
const legendItems = data.variantOrder.map((variant, index) => ({
  label: variant.name,
  color: palette[index],
}));
const totals: PlotSeriesDatum[] = data.variantOrder
  .map((variant) => {
    const value = rows
      .filter((row) => cellText(row, "variant_id") === variant.id)
      .reduce((sum, row) => sum + (cellNumber(row, "value") ?? 0), 0);
    return {
      label: variant.name,
      series: variant.name,
      units,
      variantId: variant.id,
      value,
    };
  })
  .filter((row) => row.value !== 0);
const subtitle = subtitleProp ?? `${labelize(metricGroup)} totals by modeled variant${units ? `, in ${units}.` : "."}`;
const svg =
  totals.length > 0
    ? await barChart(totals, {
        yLabel: `${labelize(metricGroup)}${units ? ` (${units})` : ""}`,
        colorDomain: legendItems.map((item) => item.label),
        colorRange: legendItems.map((item) => item.color),
        units,
      })
    : "";
---

{
  data.manifest.status === "pending" || totals.length === 0 ? (
    <DataState state="pending" title="Source energy chart pending" message={`No ${labelize(metricGroup)} rows are available yet.`} />
  ) : (
    <figure class="btwr-chart-frame" data-chart="source-energy">
      <div class="btwr-chart-frame__header">
        <h3>{title}</h3>
        <p class="btwr-chart-frame__subtitle">{subtitle}</p>
      </div>
      <ul class="btwr-chart-legend" aria-label="Source energy variants">
        {legendItems.map((item) => <li><span style={`--btwr-legend-color: ${item.color}`}></span>{item.label}</li>)}
      </ul>
      <div class="btwr-chart-frame__plot" set:html={svg} />
    </figure>
  )
}
