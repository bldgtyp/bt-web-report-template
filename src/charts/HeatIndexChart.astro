---
import MetricCard from "../components/MetricCard.astro";
import { HEAT_INDEX_THRESHOLDS_C, heatIndexMetrics, loadResilienceSeries } from "../data/resilience";
import { variantColor } from "../data/rows";
import { timeSeriesChart, type TimeSeriesDatum } from "./plot";

const series = await loadResilienceSeries("summer");
const metrics = heatIndexMetrics(series);
const colors = series.zones.map((_, index) => variantColor(index));
const chartData: TimeSeriesDatum[] = series.zones.flatMap((zone) =>
  zone.values.map((value, index) => ({ timestamp: series.timestamps[index], value, series: zone.label })),
);
const outageEnd = new Date(series.timestamps[series.outageEndIndex - 1].getTime() + 3_600_000);
const svg = await timeSeriesChart(chartData, {
  yLabel: "Heat Index (°C)",
  colorDomain: series.zones.map((zone) => zone.label),
  colorRange: colors,
  outageStart: series.timestamps[series.outageStartIndex],
  outageEnd,
  threshold: HEAT_INDEX_THRESHOLDS_C.danger,
  thresholdLabel: "Danger begins (39.4°C / 103°F)",
});
---

<div class="btwr-component-stack" data-resilience-chart="heat-index">
  <figure class="btwr-chart-frame">
    <div class="btwr-chart-frame__header">
      <h3>Summer outage Heat Index</h3>
      <p class="btwr-chart-frame__subtitle">
        Full simulation series; the shaded interval is the declared 168-hour outage. REVIVE v24.1.1 requires zero
        hours in the Danger or Extreme Danger categories.
      </p>
    </div>
    <ul class="btwr-chart-legend" aria-label="Heat Index zones">
      {
        series.zones.map((zone, index) => (
          <li><span style={`--btwr-legend-color: ${colors[index]}`}></span>{zone.label}</li>
        ))
      }
    </ul>
    <div class="btwr-chart-frame__plot" set:html={svg} />
    <p class="btwr-chart-frame__meta">
      Source: {series.config.source}. Generated by {series.config.generator}. This chart evaluates the Heat Index
      category criterion only; the separate Mora deadly-day criterion requires temperature and RH inputs not present
      in this file.
    </p>
  </figure>
  <div class="btwr-metric-grid">
    {
      series.zones.map((zone) => {
        const metric = metrics[zone.id];
        return (
          <MetricCard
            label={zone.label}
            value={metric.passesHeatIndexCriterion ? "Pass" : "Does not pass"}
            note={`${metric.dangerHours} Danger h · ${metric.extremeDangerHours} Extreme Danger h`}
          />
        );
      })
    }
  </div>
</div>
