---
import DataState from "../components/DataState.astro";
import type { ReportData } from "../data/report-loader";
import { cellNumber, cellText, formatValue, siteEnergyGroupForEndUse, siteEnergyGroups } from "../data/rows";
import { axisGridBackground, linearAxis } from "./chart-axis";

interface Props {
  data: ReportData;
  subtitle?: string;
  title?: string;
}

interface SiteEnergySegment {
  color: string;
  label: string;
  value: number;
}

interface SiteEnergyVariantRow {
  label: string;
  segments: SiteEnergySegment[];
  total: number;
  variantId: string;
}

const { data, subtitle: subtitleProp, title = "Site energy by variant" } = Astro.props;
const rows = data.energy.filter((row) => cellText(row, "metric_group") === "site_energy");
const sourceUnits = cellText(rows[0] ?? {}, "units") || "kWh";
const displayUnits = sourceUnits === "kWh" ? "kWh / year" : sourceUnits;
const groups = siteEnergyGroups();
const groupedRows = new Map<string, number>();

for (const row of rows) {
  const value = cellNumber(row, "value") ?? 0;
  const group = siteEnergyGroupForEndUse(cellText(row, "end_use"));
  if (group === null || value === 0) {
    continue;
  }
  const variantId = cellText(row, "variant_id");
  const variant = data.variantOrder.find((item) => item.id === variantId);
  if (!variant) {
    continue;
  }
  const key = `${variantId}:${group.id}`;
  groupedRows.set(key, (groupedRows.get(key) ?? 0) + value);
}

const chartRows: SiteEnergyVariantRow[] = data.variantOrder
  .map((variant) => {
    const segments = groups.map((group) => ({
      color: group.color,
      label: group.label,
      value: groupedRows.get(`${variant.id}:${group.id}`) ?? 0,
    }));
    const total = segments.reduce((sum, segment) => sum + segment.value, 0);
    return {
      label: variant.name,
      segments,
      total,
      variantId: variant.id,
    };
  })
  .filter((row) => row.total !== 0);
const maxTotal = Math.max(...chartRows.map((row) => row.total), 0);
const axis = linearAxis(maxTotal);
const axisStyle = `--btwr-axis-grid: ${axisGridBackground(axis.gridStops)};`;
const subtitle = subtitleProp ?? `Annual site energy end uses by modeled variant, in ${displayUnits}.`;
---

{
  data.manifest.status === "pending" || chartRows.length === 0 ? (
    <DataState state="pending" title="Site energy chart pending" message="No site-energy rows are available yet." />
  ) : (
    <figure class="btwr-chart-frame" data-chart="site-energy">
      <div class="btwr-chart-frame__header">
        <h3>{title}</h3>
        <p class="btwr-chart-frame__subtitle">{subtitle}</p>
      </div>
      <ul class="btwr-chart-legend" aria-label="Site energy end uses">
        {groups.map((group) => <li><span style={`--btwr-legend-color: ${group.color}`}></span>{group.label}</li>)}
      </ul>
      <div class="btwr-site-energy-bars" role="img" aria-label={`Annual site energy by variant, ${displayUnits}`} style={axisStyle}>
        <div class="btwr-site-energy-bars__plot">
          <div class="btwr-site-energy-bars__grid" aria-hidden="true"></div>
          {chartRows.map((row) => (
            <div class="btwr-site-energy-bars__row">
              <div class="btwr-site-energy-bars__label">{row.label}</div>
              <div class="btwr-site-energy-bars__track">
                {row.segments.map((segment) =>
                  segment.value > 0 ? (
                    <span
                      class="btwr-site-energy-bars__segment btwr-chart-mark"
                      data-btwr-tooltip={`${row.label}\n${segment.label}: ${formatValue(segment.value, displayUnits)}`}
                      aria-label={`${row.label}, ${segment.label}: ${formatValue(segment.value, displayUnits)}`}
                      style={`--btwr-segment-color: ${segment.color}; --btwr-segment-width: ${(segment.value / axis.max) * 100}%;`}
                    >
                      <span class="btwr-site-energy-bars__sr">{segment.label}: {formatValue(segment.value, displayUnits)}</span>
                    </span>
                  ) : null,
                )}
              </div>
              <div class="btwr-site-energy-bars__total">{formatValue(row.total, sourceUnits)}</div>
            </div>
          ))}
        </div>
        <div class="btwr-site-energy-bars__axis" aria-hidden="true">
          {axis.ticks.map((tick, index) => (
            <span
              class={index === 0 ? "is-first" : index === axis.ticks.length - 1 ? "is-last" : undefined}
              style={`--btwr-tick-position: ${axis.max > 0 ? (tick / axis.max) * 100 : 0}%;`}
            >
              {formatValue(tick)}
            </span>
          ))}
        </div>
        <div class="btwr-site-energy-bars__axis-label" aria-hidden="true">{displayUnits}</div>
      </div>
    </figure>
  )
}
