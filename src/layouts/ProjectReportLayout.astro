---
import { ReportShell } from "@bldgtyp/web-report-kit";

import type { TemplateReportData } from "../data/report";
import "../styles/project.css";

interface TocItem {
  href: string;
  label: string;
}

interface Props {
  report: TemplateReportData;
  tocItems: TocItem[];
}

const { report, tocItems } = Astro.props;
const title = `${report.project.project_title} | ${report.project.phase}`;
const location = [report.project.building.city, report.project.building.state].filter(Boolean).join(", ");
const projectMeta = {
  clientName: report.project.client_name,
  buildingName: report.project.building_name,
  phase: report.project.phase,
  reportDate: report.project.report_date,
  targetStandard: report.project.target_standard,
  location,
  climateZone: report.project.building.climate_zone,
  preparedBy: report.project.prepared_by,
};
---

<ReportShell
  title={title}
  manifest={report.manifest}
  variants={report.variantOrder}
  tocItems={tocItems}
  projectMeta={projectMeta}
>
  <slot />
</ReportShell>
