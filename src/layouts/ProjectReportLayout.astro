---
import { recommendedVariant } from "../data/variants";
import componentsCss from "../styles/components.css?raw";
import printCss from "../styles/print.css?raw";
import tokensCss from "../styles/tokens.css?raw";

import { reportPageNavItems } from "../data/pages";
import type { TemplateReportData } from "../data/report";
import chartInteractionsJs from "../scripts/chart-interactions.js?raw";
import projectCss from "../styles/project.css?raw";

interface TocItem {
  href: string;
  label: string;
  number: string;
}

interface Props {
  report: TemplateReportData;
  tocItems: TocItem[];
  currentHref: string;
  pageKicker: string;
  pageLabel: string;
}

const { report, tocItems, currentHref, pageKicker, pageLabel } = Astro.props;
const manifest = report.manifest;
const variants = report.variantOrder;
const recommended = recommendedVariant(variants);
const projectName = manifest.project?.name ?? manifest.project?.slug ?? "Untitled project";
const buildingName = report.project.building_name || projectName;
const clientName = report.project.client_name || "Client";
const phase = report.project.phase || "Design analysis";
const reportDate = report.project.report_date || manifest.generated_at || "Date pending";
const variantLabel = variants.length === 1 ? "variant" : "variants";
const title = `${pageLabel} | ${report.project.project_title} | ${phase}`;
const showHero = currentHref === "/";
const showToc = currentHref !== "/";
const initialTocHref = tocItems[0]?.href;
const faviconHref =
  'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><path fill="%233E93AE" d="M6 28V12l12-7 12 7v16h-7V16H13v12H6Z"/></svg>';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400&display=swap"
    />
    <link rel="icon" href={faviconHref} />
    <title>{title}</title>
    <style set:html={tokensCss} />
    <style set:html={componentsCss} />
    <style set:html={printCss} />
    <style set:html={projectCss} />
  </head>
  <body class="btwr-report">
    <header class="btwr-report-header">
      <div class="btwr-masthead">
        <a class="btwr-brand-lockup" href="/" aria-label="Open report summary">
          <svg class="btwr-brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 3h7v7H3V3Zm11 0h7v7h-7V3ZM3 14h7v7H3v-7Zm11 0h7v7h-7v-7Z" />
          </svg>
          <span>
            <strong>BLDGTYP</strong>
            <em>/ design-phase report</em>
          </span>
        </a>
        <div class="btwr-masthead__meta" aria-label="Project and report metadata">
          <span class="btwr-masthead__project">
            <span>{clientName}</span>
            <span aria-hidden="true">·</span>
            <span>{buildingName}</span>
          </span>
          <span class="btwr-masthead__date">
            <span>Report date</span>
            <time datetime={reportDate}>{reportDate}</time>
          </span>
        </div>
        <nav class="btwr-masthead__nav" aria-label="Primary report pages">
          {
            reportPageNavItems.map((item) => (
              <a href={item.href} aria-current={item.href === currentHref ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      {
        showHero && (
          <div class="btwr-hero">
            <div class="btwr-hero__copy">
              <p class="btwr-report-header__eyebrow">
                {pageKicker} · {pageLabel} · {phase}
              </p>
              <h1>{projectName}</h1>
              <p class="btwr-hero__lede">
                {variants.length > 0
                  ? `${variants.length} ${variantLabel} tested. ${
                      recommended ? `${recommended.name} is the current recommended path.` : "The recommended path is pending."
                    }`
                  : "Project metadata is ready. PHPP-derived model data will populate this report after the scrape runs."}
              </p>
            </div>
            <div class="btwr-hero__figure" aria-hidden="true">
              <div class="btwr-placeholder-iso">
                <span>ISOMETRIC RENDER</span>
              </div>
            </div>
          </div>
        )
      }
    </header>

    <div class:list={["btwr-report-grid", !showToc && "btwr-report-grid--full"]}>
      <main id="btwr-main" class="btwr-report-main">
        <slot />
      </main>
      {
        showToc && (
          <aside class="btwr-toc" data-btwr-page-toc aria-label="Page contents">
            <a class="btwr-toc__skip" href="#btwr-main">Skip to report</a>
            <nav>
              <p>On this page</p>
              <ol>
                {tocItems.map((item) => (
                  <li class:list={[item.href === initialTocHref && "is-current"]}>
                    <a
                      href={item.href}
                      data-btwr-toc-link
                      aria-current={item.href === initialTocHref ? "location" : undefined}
                    >
                      <span>{item.number}</span>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
            <div class="btwr-toc__recommendation">
              <p>Recommendation</p>
              <strong>{recommended?.name ?? "Pending"}</strong>
              <span>{recommended ? "Current preferred model variant." : "Set by manifest after PHPP scrape."}</span>
            </div>
          </aside>
        )
      }
    </div>

    <footer class="btwr-report-footer">
      <p>© BLDGTYP, LLC · {buildingName}</p>
      <p>
        {manifest.generated_at ? `Generated ${manifest.generated_at}` : "Generated date pending"}
        {manifest.phpp_version ? ` · PHPP ${manifest.phpp_version}` : ""}
        {manifest.schema_version ? ` · schema ${manifest.schema_version}` : ""}
      </p>
    </footer>
    <script is:inline>
      (() => {
        const toc = document.querySelector("[data-btwr-page-toc]");
        if (!toc) {
          return;
        }

        const links = Array.from(toc.querySelectorAll("[data-btwr-toc-link]"));
        const sections = links
          .map((link) => {
            const href = link.getAttribute("href");
            const id = href?.startsWith("#") ? href.slice(1) : "";
            const heading = id ? document.getElementById(id) : null;
            const section = heading?.closest(".btwr-section") ?? heading;
            return href && section ? { href, link, section } : null;
          })
          .filter(Boolean);

        if (sections.length === 0) {
          return;
        }

        function setCurrent(href) {
          for (const item of sections) {
            const isCurrent = item.href === href;
            item.link.toggleAttribute("aria-current", isCurrent);
            if (isCurrent) {
              item.link.setAttribute("aria-current", "location");
            }
            item.link.closest("li")?.classList.toggle("is-current", isCurrent);
          }
        }

        function currentSectionHref() {
          const scrollBottom = window.scrollY + window.innerHeight;
          const documentHeight = document.documentElement.scrollHeight;
          if (scrollBottom >= documentHeight - 4) {
            return sections[sections.length - 1].href;
          }

          const activationLine = Math.min(window.innerHeight * 0.35, 220);
          let current = sections[0];

          for (const item of sections) {
            const rect = item.section.getBoundingClientRect();
            if (rect.top <= activationLine && rect.bottom > activationLine) {
              return item.href;
            }
            if (rect.top <= activationLine) {
              current = item;
            }
          }

          return current.href;
        }

        let frame = 0;
        function updateCurrentSection() {
          if (frame) {
            return;
          }

          frame = window.requestAnimationFrame(() => {
            frame = 0;
            setCurrent(currentSectionHref());
          });
        }

        for (const item of sections) {
          item.link.addEventListener("click", () => {
            setCurrent(item.href);
            window.setTimeout(updateCurrentSection, 80);
          });
        }

        window.addEventListener("scroll", updateCurrentSection, { passive: true });
        window.addEventListener("resize", updateCurrentSection);
        window.addEventListener("hashchange", updateCurrentSection);
        updateCurrentSection();
      })();
    </script>
    <script is:inline type="module" set:html={chartInteractionsJs}></script>
  </body>
</html>
