---
import Appendix, { frontmatter as appendix } from "../../../content/appendix.mdx";
import EnergyModel, { frontmatter as energyModel } from "../../../content/energy-model.mdx";
import EnergyModelPanels from "../../components/EnergyModelPanels.astro";
import ReportSection from "../../components/ReportSection.astro";
import VariantSummaryTable from "../../components/VariantSummaryTable.astro";
import { reportPages } from "../../data/pages";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.energyModel;
const sections = {
  energyModel: { href: "#energy-model", label: "Energy model", number: "01" },
  modelData: { href: "#model-data", label: "Model data", number: "02" },
};
const tocItems = Object.values(sections);
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSection
    id="energy-model"
    Content={EnergyModel}
    kicker={sections.energyModel.number}
    title={energyModel.title}
    dek={energyModel.dek}
  >
    <EnergyModelPanels />
  </ReportSection>
  <ReportSection id="model-data" Content={Appendix} kicker={sections.modelData.number} title="Model data" dek={appendix.dek}>
    <VariantSummaryTable />
  </ReportSection>
</ProjectReportLayout>
