---
import AeroBarrier, { frontmatter as aeroBarrier } from "../../../content/envelope/aerobarrier.mdx";
import Airtightness, { frontmatter as airtightness } from "../../../content/envelope/airtightness.mdx";
import Assemblies, { frontmatter as assemblies } from "../../../content/envelope/assemblies.mdx";
import AirtightnessHeatLossChart from "../../charts/AirtightnessHeatLossChart.astro";
import AssemblyCards from "../../components/AssemblyCards.astro";
import ReportSection from "../../components/ReportSection.astro";
import { reportPages } from "../../data/pages";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.envelope;
const tocItems = [
  { href: "#recommended-assemblies", label: assemblies.title, number: assemblies.kicker },
  { href: "#building-airtightness", label: airtightness.title, number: airtightness.kicker },
  { href: "#aerobarrier", label: aeroBarrier.title, number: aeroBarrier.kicker },
];
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSection
    id="recommended-assemblies"
    Content={Assemblies}
    kicker={assemblies.kicker}
    title={assemblies.title}
    callout_label={assemblies.callout_label}
    callout_body={assemblies.callout_body}
  >
    <AssemblyCards />
  </ReportSection>
  <ReportSection
    id="building-airtightness"
    Content={Airtightness}
    kicker={airtightness.kicker}
    title={airtightness.title}
  >
    <AirtightnessHeatLossChart data={report} />
  </ReportSection>
  <ReportSection id="aerobarrier" Content={AeroBarrier} kicker={aeroBarrier.kicker} title={aeroBarrier.title}>
    <figure class="btwr-section-hero" slot="before-content">
      <img
        src="/assets/envelope/aerobarrier.jpg"
        width="1200"
        height="500"
        alt="AeroBarrier spray nozzle applying aerosolized sealant inside a framed building."
      />
    </figure>
  </ReportSection>
</ProjectReportLayout>
