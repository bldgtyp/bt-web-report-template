---
import AssemblyCards from "../../components/AssemblyCards.astro";
import ReportSectionList from "../../components/ReportSectionList.astro";
import AeroBarrierHero from "../../components/sections/AeroBarrierHero.astro";
import AirtightnessChart from "../../components/sections/AirtightnessChart.astro";
import { reportPages } from "../../data/pages";
import { envelopeSections } from "../../data/report-sections";
import { tocItemsFromSections, type SectionExtras } from "../../data/sections";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.envelope;

// Presence of the .mdx files decides what renders. The glob does not recurse
// into `envelope/assemblies/`, which AssemblyCards globs separately.
const sections = envelopeSections();
const tocItems = tocItemsFromSections(sections);

// Sections absent from this map render as prose only — the masonry primer is
// the archetype, and deleting its file removes the section entirely.
const extras: Record<string, SectionExtras> = {
  "recommended-assemblies": { Children: AssemblyCards },
  "building-airtightness": { Children: AirtightnessChart },
  aerobarrier: { Before: AeroBarrierHero },
};
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSectionList sections={sections} extras={extras} report={report} />
</ProjectReportLayout>
