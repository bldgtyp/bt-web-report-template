---
import ReportSectionList from "../../components/ReportSectionList.astro";
import RadiationImage from "../../components/sections/RadiationImage.astro";
import SiteShadingImages from "../../components/sections/SiteShadingImages.astro";
import WindowThermalComfortHero from "../../components/sections/WindowThermalComfortHero.astro";
import { reportPages } from "../../data/pages";
import { loadSections, tocItemsFromSections, type SectionExtras } from "../../data/sections";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.windows;

const sections = loadSections(import.meta.glob("../../../content/windows/*.mdx", { eager: true }));
const tocItems = tocItemsFromSections(sections);

// Every section here carries imagery driven by its own frontmatter. The web
// build keeps the lightbox anchors, so these render with `interactive`
// defaulting to true.
const extras: Record<string, SectionExtras> = {
  "window-thermal-comfort": { Before: WindowThermalComfortHero },
  "site-shading": { Children: SiteShadingImages },
  "winter-radiation": { Children: RadiationImage },
  "summer-radiation": { Children: RadiationImage },
};
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSectionList sections={sections} extras={extras} report={report} />
</ProjectReportLayout>
