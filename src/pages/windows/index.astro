---
import SiteShading, { frontmatter as siteShading } from "../../../content/windows/site-shading.mdx";
import SummerRadiation, { frontmatter as summerRadiation } from "../../../content/windows/summer-radiation.mdx";
import WindowThermalComfort, {
  frontmatter as windowThermalComfort,
} from "../../../content/windows/window-thermal-comfort.mdx";
import WinterRadiation, { frontmatter as winterRadiation } from "../../../content/windows/winter-radiation.mdx";
import ReportSection from "../../components/ReportSection.astro";
import { reportPages } from "../../data/pages";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";
import windowThermalComfortDiagram from "../../assets/windows/window-tc-diagram.png";

const report = await loadTemplateReportData();
const page = reportPages.windows;
const sections = {
  thermalComfort: { href: "#window-thermal-comfort", label: "Window Thermal Comfort", number: "01" },
  siteShading: { href: "#site-shading", label: "Site Shading", number: "02" },
  winterRadiation: { href: "#winter-radiation", label: "Winter Radiation", number: "03" },
  summerRadiation: { href: "#summer-radiation", label: "Summer Radiation", number: "04" },
};
const tocItems = Object.values(sections);
const imageSize = { width: 1200, height: 927 };
const siteShadingImages = [
  {
    image: siteShading.sun_path_plan_image,
    imageFull: siteShading.sun_path_plan_image_full,
    alt: siteShading.sun_path_plan_alt,
    caption: siteShading.sun_path_plan_caption,
  },
  {
    image: siteShading.sun_path_iso_image,
    imageFull: siteShading.sun_path_iso_image_full,
    alt: siteShading.sun_path_iso_alt,
    caption: siteShading.sun_path_iso_caption,
  },
].filter(({ image }) => image);

const radiationImages = {
  winter: {
    image: winterRadiation.radiation_image,
    imageFull: winterRadiation.radiation_image_full,
    alt: winterRadiation.radiation_alt,
    caption: winterRadiation.radiation_caption,
  },
  summer: {
    image: summerRadiation.radiation_image,
    imageFull: summerRadiation.radiation_image_full,
    alt: summerRadiation.radiation_alt,
    caption: summerRadiation.radiation_caption,
  },
};
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSection
    id="window-thermal-comfort"
    Content={WindowThermalComfort}
    kicker={sections.thermalComfort.number}
    title={windowThermalComfort.title}
  >
    <figure class="btwr-section-hero" slot="before-content">
      <img
        src={windowThermalComfortDiagram.src}
        width={windowThermalComfortDiagram.width}
        height={windowThermalComfortDiagram.height}
        alt="Thermal comfort diagram comparing higher radiant losses at double glazing with lower radiant losses at triple glazing."
      />
    </figure>
  </ReportSection>
  <ReportSection id="site-shading" Content={SiteShading} kicker={sections.siteShading.number} title={siteShading.title}>
    <div class="btwr-window-image-grid" aria-label="Site-shading image placeholders">
      {
        siteShadingImages.map(({ image, imageFull, alt, caption }) => (
          <figure class="btwr-window-image-slot">
            <a href={imageFull ?? image} data-btwr-full-src={imageFull ?? image} data-btwr-caption={caption ?? ""}>
              <img src={image} width={imageSize.width} height={imageSize.height} alt={alt ?? ""} loading="lazy" />
            </a>
            {caption && <figcaption>{caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </ReportSection>
  <ReportSection
    id="winter-radiation"
    Content={WinterRadiation}
    kicker={sections.winterRadiation.number}
    title={winterRadiation.title}
  >
    <figure class="btwr-window-image-slot btwr-window-image-slot--wide">
      <a
        href={radiationImages.winter.imageFull ?? radiationImages.winter.image}
        data-btwr-full-src={radiationImages.winter.imageFull ?? radiationImages.winter.image}
        data-btwr-caption={radiationImages.winter.caption ?? ""}
      >
        <img
          src={radiationImages.winter.image}
          width={imageSize.width}
          height={imageSize.height}
          alt={radiationImages.winter.alt ?? ""}
          loading="lazy"
        />
      </a>
      {radiationImages.winter.caption && <figcaption>{radiationImages.winter.caption}</figcaption>}
    </figure>
  </ReportSection>
  <ReportSection
    id="summer-radiation"
    Content={SummerRadiation}
    kicker={sections.summerRadiation.number}
    title={summerRadiation.title}
  >
    <figure class="btwr-window-image-slot btwr-window-image-slot--wide">
      <a
        href={radiationImages.summer.imageFull ?? radiationImages.summer.image}
        data-btwr-full-src={radiationImages.summer.imageFull ?? radiationImages.summer.image}
        data-btwr-caption={radiationImages.summer.caption ?? ""}
      >
        <img
          src={radiationImages.summer.image}
          width={imageSize.width}
          height={imageSize.height}
          alt={radiationImages.summer.alt ?? ""}
          loading="lazy"
        />
      </a>
      {radiationImages.summer.caption && <figcaption>{radiationImages.summer.caption}</figcaption>}
    </figure>
  </ReportSection>
</ProjectReportLayout>
