---
import Mechanical, { frontmatter as mechanical } from "../../../content/mechanical.mdx";
import MechanicalPanels from "../../components/MechanicalPanels.astro";
import ReportSection from "../../components/ReportSection.astro";
import { reportPages } from "../../data/pages";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.mechanical;
const sections = {
  mechanical: { href: "#mechanical", label: "Mechanical", number: "01" },
};
const tocItems = Object.values(sections);
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSection
    id="mechanical"
    Content={Mechanical}
    kicker={sections.mechanical.number}
    title={mechanical.title}
    dek={mechanical.dek}
  >
    <MechanicalPanels />
  </ReportSection>
</ProjectReportLayout>
