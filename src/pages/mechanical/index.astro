---
import ReportSectionList from "../../components/ReportSectionList.astro";
import FreshAirFlowRatesExtras from "../../components/sections/FreshAirFlowRatesExtras.astro";
import { reportPageOrderFor, reportPages } from "../../data/pages";
import { mechanicalSections } from "../../data/report-sections";
import { tocItemsFromSections, type SectionExtras } from "../../data/sections";
import { loadTemplateReportData } from "../../data/report";
import ProjectReportLayout from "../../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const pageOrder = reportPageOrderFor(report.project.custom_pages);
const page = reportPages.mechanical;

// Presence of the .mdx files decides what renders. The glob does not recurse
// into `mechanical/plans/`, which MechanicalPlanCards globs separately.
const sections = mechanicalSections();
const tocItems = tocItemsFromSections(sections);

// The other five sections are prose-only and already fully project-editable.
const extras: Record<string, SectionExtras> = {
  "fresh-air-flow-rates": { Children: FreshAirFlowRatesExtras },
};
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  pageOrder={pageOrder}
  currentHref={page.href}
  pageLabel={page.label}
>
  <ReportSectionList sections={sections} extras={extras} report={report} />
</ProjectReportLayout>
