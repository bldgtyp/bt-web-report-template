---
import Summary, { frontmatter as summary } from "../../content/summary.mdx";
import ReportPageLinks from "../components/ReportPageLinks.astro";
import ReportSection from "../components/ReportSection.astro";
import { reportPages } from "../data/pages";
import { loadTemplateReportData } from "../data/report";
import ProjectReportLayout from "../layouts/ProjectReportLayout.astro";

const report = await loadTemplateReportData();
const page = reportPages.summary;
const sections = {
  summary: { href: "#summary", label: "Executive summary", number: "01" },
};
const tocItems = Object.values(sections);
---

<ProjectReportLayout
  report={report}
  tocItems={tocItems}
  currentHref={page.href}
  pageKicker={page.kicker}
  pageLabel={page.label}
>
  <ReportSection
    id="summary"
    Content={Summary}
    kicker={sections.summary.number}
    title={summary.title}
    dek={summary.dek}
    show_heading={false}
  >
    <ReportPageLinks />
  </ReportSection>
</ProjectReportLayout>
