---
import AssemblyCards from "../components/AssemblyCards.astro";
import PassiveHouseCertificationsInfo from "../components/PassiveHouseCertificationsInfo.astro";
import PrintCover from "../components/PrintCover.astro";
import PrintToc from "../components/PrintToc.astro";
import ReportSectionList from "../components/ReportSectionList.astro";
import AeroBarrierHero from "../components/sections/AeroBarrierHero.astro";
import AirtightnessChart from "../components/sections/AirtightnessChart.astro";
import CertificationThresholdsChart from "../components/sections/CertificationThresholdsChart.astro";
import ClimateDataChart from "../components/sections/ClimateDataChart.astro";
import Co2EmissionsPanel from "../components/sections/Co2EmissionsPanel.astro";
import FreshAirFlowRatesExtras from "../components/sections/FreshAirFlowRatesExtras.astro";
import ModelGeometryExtras from "../components/sections/ModelGeometryExtras.astro";
import ModelVariantsTables from "../components/sections/ModelVariantsTables.astro";
import RadiationImage from "../components/sections/RadiationImage.astro";
import SiteEnergyPanel from "../components/sections/SiteEnergyPanel.astro";
import SiteShadingImages from "../components/sections/SiteShadingImages.astro";
import WindowThermalComfortHero from "../components/sections/WindowThermalComfortHero.astro";
import { reportPageOrderFor } from "../data/pages";
import { loadAllPageSections } from "../data/report-sections";
import { loadTemplateReportData } from "../data/report";
import { resolveSectionExtras } from "../data/section-extras-registry";
import type { SectionExtras } from "../data/sections";
import PrintReportLayout from "../layouts/PrintReportLayout.astro";

const report = await loadTemplateReportData();
const pageOrder = reportPageOrderFor(report.project.custom_pages);
const pageGroups = loadAllPageSections(pageOrder);

// The same extras the four web page files register, flattened into one map —
// section ids are unique across the report. Adding an extra to a page file
// means adding it here too; the fixture PDF diff is what catches the omission.
//
// Rendering with `interactive={false}` is the only other difference from the
// web: the image figures drop their lightbox anchors. Summary also keeps its
// heading here, which the web page suppresses.
const coreExtras: Record<string, SectionExtras> = {
  "model-geometry": { Children: ModelGeometryExtras },
  "model-variants": { Children: ModelVariantsTables },
  "site-energy": { Children: SiteEnergyPanel },
  "co2-emissions": { Children: Co2EmissionsPanel },
  "passive-house-thresholds": { Children: CertificationThresholdsChart },
  "climate-data": { Children: ClimateDataChart },
  "passive-house-certifications": { Children: PassiveHouseCertificationsInfo },
  "recommended-assemblies": { Children: AssemblyCards },
  "building-airtightness": { Children: AirtightnessChart },
  aerobarrier: { Before: AeroBarrierHero },
  "window-thermal-comfort": { Before: WindowThermalComfortHero },
  "site-shading": { Children: SiteShadingImages },
  "winter-radiation": { Children: RadiationImage },
  "summer-radiation": { Children: RadiationImage },
  "fresh-air-flow-rates": { Children: FreshAirFlowRatesExtras },
};
---

<PrintReportLayout report={report}>
  <PrintCover report={report} />
  <PrintToc pageGroups={pageGroups} />
  {
    pageGroups.map(({ page, sections }) => (
      <ReportSectionList
        sections={sections}
        extras={page.kind === "custom" ? resolveSectionExtras(sections) : coreExtras}
        report={report}
        interactive={false}
      />
    ))
  }
</PrintReportLayout>
