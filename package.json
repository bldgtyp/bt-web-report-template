{
  "name": "@bldgtyp/web-report-template",
  "version": "0.0.1",
  "description": "Shared Astro renderer and seed content for content-only bt-web-report project repos.",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "repository": "github:bldgtyp/bt-web-report-template",
  "scripts": {
    "dev": "astro dev",
    "dev:fixture": "BTWR_DATA_DIR=../test-files/phpp/2606-Vandam-St/scrape-output astro dev --host 127.0.0.1 --port 4321",
    "dev:editor": "tinacms dev --port 4001 --noTelemetry -c \"astro dev --host 127.0.0.1 --port 4321\"",
    "build": "pnpm validate && astro build",
    "build:fixture": "BTWR_DATA_DIR=../test-files/phpp/2606-Vandam-St/scrape-output astro build",
    "build:editor": "tinacms build --local --skip-indexing --skip-cloud-checks --noTelemetry",
    "check": "astro check",
    "check:editor": "tinacms audit --noTelemetry",
    "validate": "node scripts/validate-project.mjs",
    "build:pdf": "pnpm build && node scripts/build-pdf.mjs",
    "build:pdf:fixture": "BTWR_DATA_DIR=../test-files/phpp/2606-Vandam-St/scrape-output pnpm build:pdf",
    "preview": "astro preview",
    "test:schema": "node scripts/test-project-schema.mjs",
    "test:cloudflare": "node scripts/test-cloudflare-pages-setup.mjs",
    "test:e2e": "playwright test",
    "test:ci": "scripts/ci-emulate.sh",
    "test:workflows": "node scripts/check-workflow-invariants.mjs",
    "test:integration": "vitest run tests/report-pdf.test.ts",
    "test:printable-embed": "node scripts/test-printable-embed-fixture.mjs",
    "test:unit": "vitest run --exclude tests/report-pdf.test.ts",
    "test": "vitest run",
    "smoke:fixture": "node scripts/smoke-fixture-data.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.9",
    "@bldgtyp/web-report-schemas": "^0.4.0",
    "@observablehq/plot": "^0.6.17",
    "ajv": "^8.20.0",
    "astro": "^4.16.19",
    "d3-dsv": "^3.0.1",
    "jsdom": "^24.1.3",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tinacms": "3.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.60.0",
    "@tinacms/cli": "2.3.0",
    "@types/d3-dsv": "^3.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.19.41",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.91.0"
  }
}
